+    datePublished: post.publishedAt,
+    dateModified: post.updatedAt,
+    author: {
+      "@type": "Organization",
+      name: post.author,
+      url: siteUrl,
+    },
+    publisher: {
+      "@type": "Organization",
+      name: "Supraja Hotels",
+      logo: {
+        "@type": "ImageObject",
+        url: `${siteUrl}/images/social/supraja-hotels-og.jpg`,
+      },
+    },
+    mainEntityOfPage: canonicalUrl,
+    inLanguage: "en-IN",
